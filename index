    // ==================== GENERATOR SOAL ACAK (5 SOAL PER LEVEL) ====================
    function randInt(min, max) {
      return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function generateSingleQuestion(type) {
      let n1, n2, op, needsRegroup;

      if (type === 'mixed') {
        const subTypes = ['add_no_carry', 'add_carry', 'sub_no_borrow', 'sub_borrow'];
        type = subTypes[randInt(0, subTypes.length - 1)];
      }

      if (type === 'add_no_carry') {
        op = '+';
        needsRegroup = false;
        const o1 = randInt(1, 7);
        const o2 = randInt(1, 9 - o1);
        const t1 = randInt(1, 6);
        const t2 = randInt(1, 9 - t1);
        n1 = t1 * 10 + o1;
        n2 = t2 * 10 + o2;
      } else if (type === 'add_carry') {
        op = '+';
        needsRegroup = true;
        const o1 = randInt(3, 9);
        const o2 = randInt(10 - o1, 9);
        const t1 = randInt(1, 6);
        const t2 = randInt(1, 8 - t1);
        n1 = t1 * 10 + o1;
        n2 = t2 * 10 + o2;
      } else if (type === 'sub_no_borrow') {
        op = '-';
        needsRegroup = false;
        const o2 = randInt(1, 7);
        const o1 = randInt(o2, 9);
        const t2 = randInt(1, 7);
        const t1 = randInt(t2 + 1, 9);
        n1 = t1 * 10 + o1;
        n2 = t2 * 10 + o2;
      } else {
        op = '-';
        needsRegroup = true;
        const o1 = randInt(0, 7);
        const o2 = randInt(o1 + 1, 9);
        const t2 = randInt(1, 7);
        const t1 = randInt(t2 + 1, 9);
        n1 = t1 * 10 + o1;
        n2 = t2 * 10 + o2;
      }

      const answer = op === '+' ? n1 + n2 : n1 - n2;
      const templates = op === '+' ? STORY_TEMPLATES.add : STORY_TEMPLATES.sub;
      const tpl = templates[randInt(0, templates.length - 1)];

      return {
        n1,
        n2,
        op,
        needsRegroup,
        answer,
        ansTens: Math.floor(answer / 10),
        ansOnes: answer % 10,
        storyEmoji: tpl.emoji,
        storyLocation: tpl.loc,
        storyText: tpl.text(n1, n2)
      };
    }

    function generateLevelQuestions(levelId) {
      const levelInfo = LEVELS_DATA.find(l => l.id === levelId);
      const list = [];
      const usedPairs = new Set();

      while (list.length < 5) {
        const q = generateSingleQuestion(levelInfo.type);
        const key = `${q.n1}${q.op}${q.n2}`;
        if (!usedPairs.has(key)) {
          usedPairs.add(key);
          list.push(q);
        }
      }
      return list;
    }

    // ==================== MULAI & TAMPILKAN SOAL ====================
    function startLevel(levelId) {
      sfxClick();
      gameState.currentLevel = levelId;
      gameState.questions = generateLevelQuestions(levelId);
      gameState.currentQIndex = 0;
      gameState.levelMistakes = 0;

      const levelInfo = LEVELS_DATA.find(l => l.id === levelId);
      document.getElementById('game-level-badge').textContent = `Level ${levelId}`;
      document.getElementById('game-level-title').textContent = levelInfo.title;

      hideAllScreens();
      document.getElementById('screen-game').classList.remove('hidden');
      renderQuestion();
    }

    function retryCurrentLevel() {
      startLevel(gameState.currentLevel);
    }

    function renderQuestion() {
      const q = gameState.questions[gameState.currentQIndex];
      gameState.questionMistakes = 0;
      gameState.solvedCurrent = false;
      gameState.inputs = { carryTens: '', ansOnes: '', ansTens: '' };
      gameState.activeSlot = 'ansOnes';

      const dotsContainer = document.getElementById('question-dots');
      dotsContainer.innerHTML = '';
      for (let i = 0; i < 5; i++) {
        const dot = document.createElement('div');
        if (i < gameState.currentQIndex) {
          dot.className = 'w-7 h-7 xl:w-9 xl:h-9 rounded-full bg-green-500 text-white font-bold text-xs xl:text-sm flex items-center justify-center shadow-xs';
          dot.textContent = '✓';
        } else if (i === gameState.currentQIndex) {
          dot.className = 'w-8 h-8 xl:w-10 xl:h-10 rounded-full bg-amber-400 text-amber-950 font-display font-bold text-sm xl:text-base flex items-center justify-center ring-2 ring-amber-600 shadow';
          dot.textContent = i + 1;
        } else {
          dot.className = 'w-7 h-7 xl:w-9 xl:h-9 rounded-full bg-slate-200 text-slate-500 font-bold text-xs xl:text-sm flex items-center justify-center';
          dot.textContent = i + 1;
        }
        dotsContainer.appendChild(dot);
      }

      document.getElementById('story-emoji').textContent = q.storyEmoji;
      document.getElementById('story-location').textContent = q.storyLocation;
      document.getElementById('story-number-label').textContent = `Soal ${gameState.currentQIndex + 1} dari 5`;
      document.getElementById('story-text').textContent = q.storyText;

      const t1 = Math.floor(q.n1 / 10);
      const o1 = q.n1 % 10;
      const t2 = Math.floor(q.n2 / 10);
      const o2 = q.n2 % 10;

      document.getElementById('num1-tens').textContent = t1;
      document.getElementById('num1-ones').textContent = o1;
      document.getElementById('num2-tens').textContent = t2;
      document.getElementById('num2-ones').textContent = o2;

      const opEl = document.getElementById('operator-symbol');
      opEl.textContent = q.op;
      opEl.className = q.op === '+'
        ? 'w-11 h-11 sm:w-12 sm:h-12 xl:w-14 xl:h-14 rounded-2xl bg-emerald-500 text-white font-display text-3xl sm:text-4xl xl:text-5xl font-bold flex items-center justify-center shadow'
        : 'w-11 h-11 sm:w-12 sm:h-12 xl:w-14 xl:h-14 rounded-2xl bg-rose-500 text-white font-display text-3xl sm:text-4xl xl:text-5xl font-bold flex items-center justify-center shadow';

      const carryLabel = document.getElementById('carry-label');
      const carryBox = document.getElementById('box-carry-tens');
      const borrowBadge = document.getElementById('borrow-hint-badge');
      const tensCrossed = document.getElementById('num1-tens-crossed');
      const onesHelper = document.getElementById('num1-ones-helper');

      tensCrossed.classList.add('hidden');
      onesHelper.classList.add('hidden');

      if (q.needsRegroup && q.op === '+') {
        carryLabel.textContent = 'Simpan';
        carryLabel.classList.remove('hidden');
        carryBox.classList.remove('hidden');
        borrowBadge.classList.add('hidden');
      } else if (q.needsRegroup && q.op === '-') {
        carryLabel.textContent = 'Sisa';
        carryLabel.classList.remove('hidden');
        carryBox.classList.remove('hidden');
        borrowBadge.classList.remove('hidden');
        onesHelper.textContent = `${o1 + 10}`;
      } else {
        carryLabel.classList.add('hidden');
        carryBox.classList.add('hidden');
        borrowBadge.classList.add('hidden');
      }

      renderVisualBlocks(q);

      document.getElementById('feedback-banner').classList.add('hidden');
      document.getElementById('btn-next-question').classList.add('hidden');
      const checkBtn = document.getElementById('btn-check-answer');
      checkBtn.disabled = false;
      checkBtn.classList.remove('opacity-50', 'pointer-events-none');

      updateSlotDisplays();
      selectSlot('ansOnes', true);
    }

    // ==================== RENDER BALOK PULUHAN & KUBUS SATUAN ====================
    function createTenRodElement() {
      const rod = document.createElement('div');
      rod.className = 'ten-rod';
      for (let i = 0; i < 9; i++) {
        rod.appendChild(document.createElement('span'));
      }
      return rod;
    }

    function createOneCubeElement() {
      const cube = document.createElement('div');
      cube.className = 'one-cube';
      return cube;
    }

    function renderVisualBlocks(q) {
      const t1 = Math.floor(q.n1 / 10);
      const o1 = q.n1 % 10;
      const t2 = Math.floor(q.n2 / 10);
      const o2 = q.n2 % 10;

      document.getElementById('blocks-label-1').textContent = `Bilangan Atas: ${q.n1}`;
      document.getElementById('blocks-label-2').textContent = `Bilangan Bawah: ${q.n2}`;
      const opNote = document.getElementById('blocks-op-note');
      opNote.textContent = q.op === '+' ? 'Digabung (+)' : 'Diambil (-)';
      opNote.className = q.op === '+' ? 'text-emerald-600 font-extrabold' : 'text-rose-600 font-extrabold';

      const b1T = document.getElementById('blocks-1-tens');
      const b1O = document.getElementById('blocks-1-ones');
      const b2T = document.getElementById('blocks-2-tens');
      const b2O = document.getElementById('blocks-2-ones');

      b1T.innerHTML = '';
      b1O.innerHTML = '';
      b2T.innerHTML = '';
      b2O.innerHTML = '';

      for (let i = 0; i < t1; i++) b1T.appendChild(createTenRodElement());
      for (let i = 0; i < o1; i++) b1O.appendChild(createOneCubeElement());
      for (let i = 0; i < t2; i++) b2T.appendChild(createTenRodElement());
      for (let i = 0; i < o2; i++) b2O.appendChild(createOneCubeElement());
    }

