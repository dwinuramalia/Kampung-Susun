    const STORY_TEMPLATES = {
      add: [
        { emoji: "🌾", loc: "Sawah Padi", text: (a, b) => `Pak Tani memanen ${a} ikat padi di pagi hari dan ${b} ikat padi di sore hari. Berapa jumlah semua ikat padi Pak Tani?` },
        { emoji: "🍊", loc: "Kebun Buah", text: (a, b) => `Bu Sari memetik ${a} buah jeruk manis. Adik memetik lagi ${b} buah jeruk. Berapa jumlah jeruk mereka sekarang?` },
        { emoji: "🥚", loc: "Kandang Ayam", text: (a, b) => `Di keranjang ada ${a} butir telur ayam. Pagi ini ayam bertelur lagi ${b} butir. Berapa total telur semuanya?` },
        { emoji: "🌽", loc: "Ladang Jagung", text: (a, b) => `Ayah mengumpulkan ${a} tongkol jagung dan Ibu mengumpulkan ${b} tongkol jagung. Berapa jumlah jagung seluruhnya?` },
        { emoji: "🎈", loc: "Balai Kampung", text: (a, b) => `Warga memasang ${a} balon merah dan ${b} balon kuning untuk lomba kampung. Berapa jumlah semua balon?` }
