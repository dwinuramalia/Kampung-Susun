<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kampung Susun - Game Matematika Kelas 2 SD</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Nunito', sans-serif;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }
    h1, h2, h3, .font-display {
      font-family: 'Fredoka', sans-serif;
    }

    /* Gaya Papan Kayu / Kartu Kampung Transparan */
    .village-board {
      background: rgba(255, 251, 235, 0.42);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 4px solid rgba(146, 64, 14, 0.85);
      box-shadow: 0 10px 25px rgba(69, 26, 3, 0.18), 0 6px 0 rgba(120, 53, 15, 0.85);
    }

    /* Efek Teks Terbaca Jelas di Atas Background Transparan */
    .text-outline-light {
      text-shadow: 0 1px 6px rgba(255, 255, 255, 0.92), 0 0 2px rgba(255, 255, 255, 0.95);
    }

    /* Pola Genteng Merah Terakota */
    .roof-banner {
      background: repeating-linear-gradient(
        90deg,
        #ef4444 0px,
        #ef4444 26px,
        #dc2626 26px,
        #dc2626 52px
      );
      border-bottom: 4px solid #7f1d1d;
    }

    /* Animasi Ceria */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    @keyframes popIn {
      0% { transform: scale(0.82); opacity: 0; }
      70% { transform: scale(1.04); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes shakeWrong {
      0%, 100% { transform: translateX(0); }
      20% { transform: translateX(-8px); }
      40% { transform: translateX(8px); }
      60% { transform: translateX(-6px); }
      80% { transform: translateX(6px); }
    }
    @keyframes starBounce {
      0%, 100% { transform: scale(1) rotate(0deg); }
      50% { transform: scale(1.25) rotate(12deg); }
    }
    @keyframes cloudDrift {
      0% { transform: translateX(-10%); }
      50% { transform: translateX(10%); }
      100% { transform: translateX(-10%); }
    }

    .animate-float { animation: floatSlow 3.2s ease-in-out infinite; }
    .animate-pop { animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    .animate-shake { animation: shakeWrong 0.45s ease-in-out; }
    .animate-star { animation: starBounce 0.7s ease-in-out; }
    .animate-cloud { animation: cloudDrift 16s ease-in-out infinite; }

    /* Balok Puluhan (10 segmen kecil) - Skala Responsif untuk Layar & IFP */
    .ten-rod {
      width: clamp(16px, 1.3vw, 24px);
      height: clamp(74px, 6.2vw, 108px);
      background: linear-gradient(180deg, #60a5fa 0%, #2563eb 100%);
      border: 2px solid #1e40af;
      border-radius: 5px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 2px 0;
      box-shadow: 2px 2px 0 #1e3a8a;
    }
    .ten-rod span {
      display: block;
      height: 1px;
      background: rgba(255, 255, 255, 0.55);
      width: 100%;
    }

    /* Kubus Satuan - Skala Responsif untuk Layar & IFP */
    .one-cube {
      width: clamp(18px, 1.45vw, 26px);
      height: clamp(18px, 1.45vw, 26px);
      background: linear-gradient(135deg, #fcd34d 0%, #f59e0b 100%);
      border: 2px solid #b45309;
      border-radius: 5px;
      box-shadow: 2px 2px 0 #92400e;
    }
    .one-cube.crossed {
      opacity: 0.35;
      position: relative;
    }
    .ten-rod.crossed {
      opacity: 0.35;
    }

    /* Efek Tombol 3D Ramah Anak */
    .btn-3d {
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }
    .btn-3d:active:not(:disabled) {
      transform: translateY(3px);
    }

    /* Kotak Input Aktif */
    .active-ring {
      box-shadow: 0 0 0 4px #10b981, 0 6px 14px rgba(16, 185, 129, 0.35);
      transform: scale(1.04);
    }
  </style>
</head>
<body class="min-h-screen bg-gradient-to-b from-sky-300 via-emerald-200 to-lime-200 text-slate-800 relative flex flex-col">

  <!-- LATAR BELAKANG KAMPUNG CERIA (GAMBAR PENUH DARI IMGUR DENGAN FALLBACK) -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <img id="bg-village-img" src="https://i.imgur.com/qWU7hRD.png" onerror="this.onerror=null; this.src='https://i.imgur.com/qWU7hRD.jpg'; this.onerror=function(){this.style.display='none'; document.getElementById('bg-village-fallback').classList.remove('hidden');};" alt="Latar Belakang Kampung Susun" class="w-full h-full object-cover object-center brightness-105 saturate-110" />

    <!-- Fallback Ilustrasi Latar Kampung jika Gambar Gagal Dimuat -->
    <div id="bg-village-fallback" class="hidden absolute inset-0 bg-gradient-to-b from-sky-300 via-sky-200 to-emerald-200">
      <div class="absolute top-6 right-8 w-20 h-20 rounded-full bg-yellow-300 shadow-[0_0_45px_#fde047] opacity-95 border-4 border-amber-200"></div>
      <div class="absolute top-12 left-8 opacity-85 animate-cloud">
        <div class="w-32 h-11 bg-white rounded-full shadow-sm"></div>
        <div class="w-16 h-16 bg-white rounded-full -mt-11 ml-6"></div>
      </div>
      <svg class="absolute bottom-0 left-0 w-full h-44 sm:h-56" viewBox="0 0 1440 260" preserveAspectRatio="none">
        <path d="M0,130 C320,40 580,190 920,100 C1180,35 1340,95 1440,80 L1440,260 L0,260 Z" fill="#4ade80" opacity="0.75"/>
        <path d="M0,165 C380,115 760,225 1120,145 C1290,105 1390,140 1440,135 L1440,260 L0,260 Z" fill="#22c55e" opacity="0.9"/>
        <path d="M0,205 C420,185 880,235 1440,190 L1440,260 L0,260 Z" fill="#16a34a"/>
      </svg>
    </div>
  </div>

  <!-- HEADER / BAR ATAS (SELARAS TEMA LOGO KAYU & GENTENG KAMPUNG, DIOPTIMALKAN UNTUK IFP) -->
  <header class="relative z-10 max-w-7xl 2xl:max-w-[1600px] w-full mx-auto px-3 sm:px-6 xl:px-8 pt-3 pb-2 flex flex-wrap items-center justify-between gap-2.5">
    <button onclick="goHome()" class="flex items-center gap-3 bg-amber-100 hover:bg-amber-50 px-4 py-2.5 rounded-2xl border-3 border-amber-800 shadow-md btn-3d cursor-pointer">
      <!-- Logo Kampung Susun dari Imgur dengan Fallback SVG -->
      <img src="https://i.imgur.com/cP85wxm.png" onerror="this.onerror=null; this.src='https://i.imgur.com/cP85wxm.jpg'; this.onerror=function(){this.style.display='none'; document.getElementById('header-logo-fallback').classList.remove('hidden');};" alt="Logo Kampung Susun" class="w-10 h-10 xl:w-12 xl:h-12 object-contain rounded-xl shrink-0" />
      <svg id="header-logo-fallback" class="hidden w-9 h-9 xl:w-11 xl:h-11 shrink-0" viewBox="0 0 64 64">
        <path d="M8 30 L32 10 L56 30 Z" fill="#ef4444" stroke="#7f1d1d" stroke-width="3" stroke-linejoin="round"/>
        <rect x="14" y="28" width="36" height="26" rx="4" fill="#fde68a" stroke="#92400e" stroke-width="3"/>
        <rect x="20" y="34" width="9" height="15" rx="2" fill="#2563eb" stroke="#1e3a8a" stroke-width="2"/>
        <rect x="35" y="40" width="9" height="9" rx="2" fill="#f59e0b" stroke="#92400e" stroke-width="2"/>
      </svg>
      <div class="text-left">
        <span class="font-display font-bold text-lg sm:text-xl xl:text-2xl text-amber-950 leading-none block">Kampung Susun</span>
        <span class="text-xs xl:text-sm font-extrabold text-amber-800">Matematika Kelas 2 SD</span>
      </div>
    </button>

    <!-- Navigasi Cepat Menu Utama -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-2.5">
      <!-- Penghitung Bintang Total -->
      <div class="bg-yellow-200 border-2 border-amber-700 px-3.5 py-2 rounded-2xl shadow-sm flex items-center gap-1.5">
        <span class="text-lg sm:text-xl xl:text-2xl">⭐</span>
        <span id="total-stars-display" class="font-display font-bold text-base sm:text-lg xl:text-2xl text-amber-950">0</span>
      </div>

      <!-- Tombol Peta Kampung -->
      <button id="btn-map-nav" onclick="showMapScreen()" class="hidden sm:flex items-center gap-1.5 bg-sky-500 hover:bg-sky-600 text-white font-display font-semibold px-4 py-2.5 rounded-2xl border-b-4 border-sky-800 shadow btn-3d cursor-pointer text-sm xl:text-base">
        <span>🗺️</span>
        <span>Peta</span>
      </button>

      <!-- Tombol Layar Penuh (Sangat Berguna di IFP Kelas) -->
      <button id="fullscreen-toggle-btn" onclick="toggleFullscreen()" aria-label="Layar Penuh IFP" title="Mode Layar Penuh IFP" class="bg-amber-50 hover:bg-white border-2 border-amber-700 w-10 h-10 xl:w-12 xl:h-12 rounded-2xl shadow-sm flex items-center justify-center text-amber-950 btn-3d cursor-pointer">
        <span id="fullscreen-icon" class="text-lg xl:text-xl">⛶</span>
      </button>

      <!-- Tombol Suara & Musik On/Off (Hanya Logo Ikon) -->
      <button id="sound-toggle-btn" onclick="toggleSound()" aria-label="Suara dan Musik" title="Musik & Efek" class="bg-amber-50 hover:bg-white border-2 border-amber-700 w-10 h-10 xl:w-12 xl:h-12 rounded-2xl shadow-sm flex items-center justify-center text-amber-950 btn-3d cursor-pointer">
        <span id="sound-icon" class="text-lg xl:text-xl">🔊</span>
      </button>
    </div>
  </header>

  <!-- KONTEN UTAMA (SKALA LEBAR & NYAMAN UNTUK LAYAR IFP) -->
  <main class="relative z-10 max-w-7xl 2xl:max-w-[1600px] w-full mx-auto px-3 sm:px-6 xl:px-8 py-2 flex-1 flex flex-col justify-center">

    <!-- ==================== 1. LAYAR BERANDA (TANPA KOTAK BESAR AGAR BACKGROUND TERLIHAT PENUH) ==================== -->
    <section id="screen-home" class="text-center animate-pop max-w-5xl xl:max-w-6xl w-full mx-auto my-2">
      <div class="px-2 sm:px-6 py-4 xl:py-6 flex flex-col items-center">
        <!-- LOGO GAME UTAMA -->
        <div class="w-full max-w-sm sm:max-w-md xl:max-w-xl mx-auto mb-4 xl:mb-5 animate-float flex flex-col items-center justify-center">
          <img id="main-game-logo-img" src="https://i.imgur.com/cP85wxm.png" onerror="this.onerror=null; this.src='https://i.imgur.com/cP85wxm.jpg'; this.onerror=function(){this.style.display='none'; document.getElementById('main-game-logo-fallback').classList.remove('hidden');};" alt="Logo Game Kampung Susun" class="w-56 sm:w-72 md:w-80 xl:w-96 h-auto max-h-48 sm:max-h-56 xl:max-h-64 object-contain rounded-3xl drop-shadow-[0_10px_18px_rgba(0,0,0,0.28)] mx-auto" />

          <!-- Fallback SVG Logo Game jika Gambar Imgur Tidak Termuat -->
          <svg id="main-game-logo-fallback" class="hidden w-full max-w-md mx-auto drop-shadow-lg" viewBox="0 0 560 220" preserveAspectRatio="xMidYMid meet">
            <rect x="65" y="135" width="22" height="58" rx="4" fill="#2563eb" stroke="#1e3a8a" stroke-width="3"/>
            <rect x="93" y="148" width="22" height="45" rx="4" fill="#3b82f6" stroke="#1e3a8a" stroke-width="3"/>
            <rect x="448" y="162" width="24" height="24" rx="5" fill="#f59e0b" stroke="#92400e" stroke-width="3"/>
            <rect x="478" y="150" width="24" height="24" rx="5" fill="#fbbf24" stroke="#92400e" stroke-width="3"/>
            <path d="M115 74 L280 14 L445 74 Z" fill="#ef4444" stroke="#7f1d1d" stroke-width="5" stroke-linejoin="round"/>
            <rect x="128" y="70" width="304" height="122" rx="22" fill="#d97706" stroke="#78350f" stroke-width="5"/>
            <rect x="138" y="78" width="284" height="106" rx="16" fill="#fef3c7" stroke="#b45309" stroke-width="3"/>
            <text x="280" y="122" text-anchor="middle" font-family="'Fredoka', sans-serif" font-weight="700" font-size="38" fill="#78350f">KAMPUNG</text>
            <text x="280" y="168" text-anchor="middle" font-family="'Fredoka', sans-serif" font-weight="700" font-size="44" fill="#dc2626">SUSUN</text>
          </svg>
        </div>

        <!-- Subjudul Pengantar Singkat -->
        <p class="text-amber-950 font-extrabold text-sm sm:text-base xl:text-xl max-w-2xl mx-auto mb-5 xl:mb-6 bg-white/45 backdrop-blur-xs border-2 border-amber-600/75 px-5 py-2.5 rounded-2xl shadow-sm text-outline-light">
          Ayo berpetualang menghitung susun ke bawah sampai 100 bersama para penjaga kampung!
        </p>

        <!-- Ilustrasi Karakter Penjaga (Sejajar & Simetris Transparan) -->
        <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4 xl:gap-6 max-w-4xl xl:max-w-5xl mx-auto mb-6 xl:mb-8">
          <!-- Kartu Pak Puluh -->
          <div class="bg-blue-50/35 backdrop-blur-xs border-3 border-blue-700/80 rounded-3xl p-4 xl:p-5 flex items-center gap-4 xl:gap-5 text-left shadow-md hover:scale-[1.01] transition">
            <div class="w-20 h-20 sm:w-24 sm:h-24 xl:w-28 xl:h-28 rounded-2xl bg-gradient-to-b from-sky-300/65 to-blue-500/65 flex items-center justify-center shrink-0 shadow-inner border-3 border-blue-900/80 relative overflow-hidden">
              <!-- Gambar Pak Puluh dari Imgur dengan Fallback SVG -->
              <img src="https://i.imgur.com/AiTdtpf.png" onerror="this.onerror=null; this.src='https://i.imgur.com/AiTdtpf.jpg'; this.onerror=function(){this.style.display='none'; document.getElementById('pak-puluh-fallback').classList.remove('hidden');};" alt="Logo Pak Puluh" class="w-full h-full object-contain p-1" />
              <svg id="pak-puluh-fallback" class="hidden w-16 h-16" viewBox="0 0 80 80">
                <rect x="8" y="34" width="12" height="38" rx="3" fill="#1d4ed8" stroke="#1e3a8a" stroke-width="2.5"/>
                <circle cx="42" cy="40" r="16" fill="#fed7aa" stroke="#78350f" stroke-width="3"/>
                <path d="M18 28 L42 12 L66 28 Z" fill="#facc15" stroke="#854d0e" stroke-width="3" stroke-linejoin="round"/>
                <circle cx="37" cy="39" r="2.2" fill="#1e293b"/>
                <circle cx="47" cy="39" r="2.2" fill="#1e293b"/>
                <path d="M36 46 Q42 52 48 46" stroke="#78350f" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <path d="M22 74 C22 58 62 58 62 74 Z" fill="#2563eb" stroke="#1e3a8a" stroke-width="3"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <span class="inline-block bg-blue-700/95 text-white text-xs xl:text-sm font-extrabold px-3 py-0.5 rounded-full mb-1 border border-blue-950 shadow-2xs">KOLOM PULUHAN</span>
              <h2 class="font-display text-xl xl:text-2xl font-bold text-blue-950 leading-tight text-outline-light">Pak Puluh</h2>
              <p class="text-xs sm:text-sm xl:text-base text-blue-950 font-extrabold leading-snug mt-0.5 text-outline-light">Penjaga balok puluhan yang kuat dan teliti!</p>
            </div>
          </div>

          <!-- Kartu Bu Satuan -->
          <div class="bg-amber-50/35 backdrop-blur-xs border-3 border-amber-700/80 rounded-3xl p-4 xl:p-5 flex items-center gap-4 xl:gap-5 text-left shadow-md hover:scale-[1.01] transition">
            <div class="w-20 h-20 sm:w-24 sm:h-24 xl:w-28 xl:h-28 rounded-2xl bg-gradient-to-b from-amber-300/65 to-amber-500/65 flex items-center justify-center shrink-0 shadow-inner border-3 border-amber-900/80 relative overflow-hidden">
              <!-- Gambar Bu Satuan dari Imgur dengan Fallback SVG -->
              <img src="https://i.imgur.com/E3fo2tg.png" onerror="this.onerror=null; this.src='https://i.imgur.com/E3fo2tg.jpg'; this.onerror=function(){this.style.display='none'; document.getElementById('bu-satuan-fallback').classList.remove('hidden');};" alt="Logo Bu Satuan" class="w-full h-full object-contain p-1" />
              <svg id="bu-satuan-fallback" class="hidden w-16 h-16" viewBox="0 0 80 80">
                <circle cx="40" cy="40" r="15" fill="#fed7aa" stroke="#78350f" stroke-width="3"/>
                <path d="M16 28 L40 13 L64 28 Z" fill="#fde047" stroke="#854d0e" stroke-width="3" stroke-linejoin="round"/>
                <circle cx="35" cy="39" r="2.2" fill="#1e293b"/>
                <circle cx="45" cy="39" r="2.2" fill="#1e293b"/>
                <path d="M35 45 Q40 50 45 45" stroke="#78350f" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <path d="M22 74 C22 58 58 58 58 74 Z" fill="#ef4444" stroke="#7f1d1d" stroke-width="3"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <span class="inline-block bg-amber-700/95 text-white text-xs xl:text-sm font-extrabold px-3 py-0.5 rounded-full mb-1 border border-amber-950 shadow-2xs">KOLOM SATUAN</span>
              <h2 class="font-display text-xl xl:text-2xl font-bold text-amber-950 leading-tight text-outline-light">Bu Satuan</h2>
              <p class="text-xs sm:text-sm xl:text-base text-amber-950 font-extrabold leading-snug mt-0.5 text-outline-light">Penjaga kubus satuan yang ramah dan cekatan!</p>
            </div>
          </div>
        </div>

        <!-- Tombol Menu Utama Beranda -->
        <div class="w-full flex flex-col items-center justify-center mb-5 xl:mb-6">
          <button onclick="showMapScreen()" class="w-full sm:w-auto min-w-[280px] xl:min-w-[340px] bg-green-500 hover:bg-green-600 text-white font-display text-xl sm:text-2xl xl:text-3xl font-bold px-10 xl:px-12 py-4 xl:py-5 rounded-3xl border-3 border-green-900 border-b-6 shadow-lg btn-3d cursor-pointer flex items-center justify-center gap-3">
            <span>🚀</span>
            <span>Mulai Bermain!</span>
          </button>
        </div>

        <!-- Tombol Pendukung Belajar -->
        <div class="w-full max-w-4xl xl:max-w-5xl mx-auto pt-2 xl:pt-3 grid grid-cols-1 sm:grid-cols-3 gap-3 xl:gap-4">
          <button onclick="openModal('modal-tujuan')" class="w-full bg-purple-100/75 hover:bg-purple-200/95 backdrop-blur-xs text-purple-950 border-2 border-purple-700 font-display font-bold px-4 py-3 xl:py-3.5 rounded-2xl text-sm xl:text-base flex items-center justify-center gap-2 btn-3d cursor-pointer shadow-md text-outline-light">
            <span>🎯</span>
            <span>Tujuan Belajar</span>
          </button>
          <button onclick="openModal('modal-materi')" class="w-full bg-amber-100/75 hover:bg-amber-200/95 backdrop-blur-xs text-amber-950 border-2 border-amber-700 font-display font-bold px-4 py-3 xl:py-3.5 rounded-2xl text-sm xl:text-base flex items-center justify-center gap-2 btn-3d cursor-pointer shadow-md text-outline-light">
            <span>📖</span>
            <span>Materi Belajar</span>
          </button>
          <button onclick="openChatModal()" class="w-full bg-sky-100/75 hover:bg-sky-200/95 backdrop-blur-xs text-sky-950 border-2 border-sky-700 font-display font-bold px-4 py-3 xl:py-3.5 rounded-2xl text-sm xl:text-base flex items-center justify-center gap-2 btn-3d cursor-pointer shadow-md text-outline-light">
            <span>💬</span>
            <span>Tanya Pak Puluh & Bu Satuan</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ==================== 2. LAYAR PETA KAMPUNG (PILIH LEVEL — SKALA IFP) ==================== -->
    <section id="screen-map" class="hidden village-board rounded-3xl overflow-hidden animate-pop">
      <div class="roof-banner h-4 w-full"></div>
      <div class="p-4 sm:p-6 xl:p-7">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
          <div>
            <h2 class="font-display text-2xl sm:text-3xl xl:text-4xl font-bold text-amber-950">🗺️ Peta Petualangan Kampung Susun</h2>
            <p class="text-amber-900 font-bold text-sm sm:text-base xl:text-lg">Ikuti jalan setapak desa dan selesaikan misi di setiap tempat!</p>
          </div>
          <div class="bg-green-200 border-2 border-green-700 px-4 py-2 rounded-2xl text-green-950 font-extrabold text-sm xl:text-base self-start sm:self-auto shadow-xs">
            Wilayah Terbuka: <span id="unlocked-count">1</span> / 5
          </div>
        </div>

        <!-- PETA VISUAL DESA INTERAKTIF BERGAYA GAME PETUALANGAN -->
        <div class="relative rounded-3xl border-4 border-amber-800 shadow-inner overflow-hidden mb-4 bg-gradient-to-b from-sky-300 via-emerald-200 to-lime-300 h-[360px] sm:h-[430px] md:h-[480px] xl:h-[58vh] max-h-[640px]">
          <!-- Gambar Peta Kampung dari Imgur (PeX5Pyt) -->
          <img id="adventure-map-img" src="https://i.imgur.com/PeX5Pyt.png" onerror="this.onerror=null; this.src='https://i.imgur.com/PeX5Pyt.jpg'; this.onerror=function(){this.style.display='none'; document.getElementById('adventure-map-fallback').classList.remove('hidden');};" alt="Peta Petualangan Kampung Susun" class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none" />

          <!-- Fallback Ilustrasi Peta Desa SVG -->
          <svg id="adventure-map-fallback" class="hidden absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1000 500" preserveAspectRatio="none">
            <rect width="1000" height="190" fill="#bae6fd"/>
            <path d="M0,185 Q240,120 480,175 T1000,155 L1000,500 L0,500 Z" fill="#bef264"/>
            <path d="M0,235 Q310,195 620,245 T1000,220 L1000,500 L0,500 Z" fill="#86efac"/>
            <path d="M120,390 C230,360 260,260 350,255 C450,250 470,350 560,340 C660,330 700,210 865,195" fill="none" stroke="#d97706" stroke-width="46" stroke-linecap="round"/>
